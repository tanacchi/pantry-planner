# Base URL the server-side API clients (ui/app/lib/client/api/index.server.ts)
# use. Without this, the generated client falls back to
# "http://localhost" (port 80), and every API call fails.
API_HOST=http://localhost:8000

# LIFF integration (optional). Leave unset for local/E2E development:
# LiffProvider calls liff.login() once liff.init() resolves, which redirects
# away from the current page. Without a valid VITE_LIFF_ID, liff.init()
# rejects and that redirect never fires.
# VITE_LIFF_ID=
# VITE_USE_LIFF_MOCK=true
# VITE_DUMMY_USER_ID=
