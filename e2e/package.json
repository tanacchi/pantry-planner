{
  "name": "pantry-planner-e2e",
  "version": "1.0.0",
  "description": "E2E tests for Pantry Planner",
  "scripts": {
    "postinstall": "pnpm exec playwright install",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:all-projects": "run-p test:mobile-chrome test:mobile-safari",
    "test:mobile-chrome": "playwright test --project=\"Mobile Chrome\"",
    "test:mobile-safari": "playwright test --project=\"Mobile Safari\"",
    "report": "playwright show-report",
    "lint": "biome check .",
    "lint:biome": "biome check .",
    "lint:fix": "biome check . --write",
    "lint:biome:fix": "biome check . --write",
    "lint:check": "biome check . --no-errors-on-unmatched",
    "lint:biome:check": "biome check . --no-errors-on-unmatched",
    "servers:start": "run-p servers:api servers:ui",
    "servers:api": "pnpm -C ../api run start:dev",
    "servers:ui": "pnpm -C ../ui run dev",
    "servers:stop": "run-p servers:api:stop servers:ui:stop",
    "servers:api:stop": "pkill -f \"nest start\" || true",
    "servers:ui:stop": "pkill -f \"remix vite:dev\" || true",
    "setup": "run-s setup:deps setup:browsers setup:db",
    "setup:deps": "run-s setup:api setup:ui",
    "setup:api": "pnpm -C ../api install --frozen-lockfile",
    "setup:ui": "pnpm -C ../ui install --frozen-lockfile",
    "setup:browsers": "pnpm exec playwright install",
    "setup:db": "run-s setup:db:push setup:db:seed",
    "setup:db:push": "pnpm -C ../api run db:push",
    "setup:db:seed": "pnpm -C ../api run db:seed:e2e",
    "clean": "run-p clean:*",
    "clean:reports": "rm -rf playwright-report",
    "clean:results": "rm -rf test-results",
    "clean:deps": "rm -rf node_modules",
    "dev": "run-s setup servers:start",
    "ci": "run-s setup lint test",
    "ci:lint": "biome check . --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.40.0",
    "@types/node": "^24.0.1",
    "npm-run-all2": "^6.1.0",
    "typescript": "^5.0.0"
  }
}
